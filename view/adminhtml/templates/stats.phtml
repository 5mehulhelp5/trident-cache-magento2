                        <div class="trident-stat trident-stat-hit">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml($viewModel->formatNumber((int)($stats['hits'] ?? 0))) ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Cache Hits')) ?></span>
                        </div>
                        <div class="trident-stat trident-stat-miss">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml($viewModel->formatNumber((int)($stats['misses'] ?? 0))) ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Cache Misses')) ?></span>
                        </div>
                        <div class="trident-stat trident-stat-pass">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml($viewModel->formatNumber((int)($stats['passes'] ?? 0))) ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Bypassed')) ?></span>
                        </div>
                        <div class="trident-stat trident-stat-ratio">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml($viewModel->formatPercentage((float)($stats['hit_ratio'] ?? 0))) ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Hit Ratio')) ?></span>
                        </div>
                    </div>
                </div>

                <!-- Evictions -->
                <div class="trident-card trident-card-evictions">
                    <h3 class="trident-card-title"><?= $escaper->escapeHtml(__('Evictions')) ?></h3>
                    <div class="trident-stats-row">
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml($viewModel->formatNumber((int)($stats['evictions'] ?? 0))) ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Total Evictions')) ?></span>
                        </div>
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml($viewModel->formatBytes((int)($stats['evicted_bytes'] ?? 0))) ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Evicted Bytes')) ?></span>
                        </div>
                    </div>
                </div>

                <!-- Tags Index -->
                <div class="trident-card trident-card-tags">
                    <h3 class="trident-card-title"><?= $escaper->escapeHtml(__('Tag Index')) ?></h3>
                    <div class="trident-stats-row">
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml($viewModel->formatNumber((int)($stats['unique_tags'] ?? 0))) ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Unique Tags')) ?></span>
                        </div>
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml($viewModel->formatNumber((int)($stats['indexed_keys'] ?? 0))) ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Indexed Keys')) ?></span>
                        </div>
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml($viewModel->formatBytes((int)($stats['tag_index_memory_bytes'] ?? 0))) ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Index Memory')) ?></span>
                        </div>
                    </div>
                </div>

                <!-- Compression -->
                <?php if (isset($stats['compressed_entries']) && $stats['compressed_entries'] > 0): ?>
                <div class="trident-card trident-card-compression">
                    <h3 class="trident-card-title"><?= $escaper->escapeHtml(__('Compression')) ?></h3>
                    <div class="trident-stats-row">
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml($viewModel->formatNumber((int)$stats['compressed_entries'])) ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Compressed Entries')) ?></span>
                        </div>
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml(number_format((float)($stats['compression_ratio'] ?? 1), 2) . 'x') ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Compression Ratio')) ?></span>
                        </div>
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml($viewModel->formatBytes((int)($stats['compression_bytes_saved'] ?? 0))) ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Bytes Saved')) ?></span>
                        </div>
                    </div>
                </div>
                <?php endif; ?>
            </div>

            <?php $topUrls = $viewModel->getTopUrls(); ?>
            <?php if ($topUrls !== null && !empty($topUrls['entries'] ?? [])): ?>
                <div class="trident-card trident-card-top-urls" style="grid-column: 1 / -1;">
                    <h3 class="trident-card-title"><?= $escaper->escapeHtml(__('Top URLs by Requests')) ?></h3>
                    <div class="trident-table-wrapper">
                        <table class="admin__table-primary trident-top-urls-table">
                            <thead>
                                <tr>
                                    <th><?= $escaper->escapeHtml(__('Path')) ?></th>
                                    <th class="trident-col-right"><?= $escaper->escapeHtml(__('Requests')) ?></th>
                                    <th class="trident-col-right"><?= $escaper->escapeHtml(__('Hits')) ?></th>
                                    <th class="trident-col-right"><?= $escaper->escapeHtml(__('Hit Ratio')) ?></th>
                                    <th class="trident-col-right"><?= $escaper->escapeHtml(__('Size')) ?></th>
                                </tr>
                            </thead>
                            <tbody>
                                <?php foreach (array_slice($topUrls['entries'], 0, 10) as $entry): ?>
                                    <?php
                                    $path = $entry['path'] ?? $entry['url'] ?? '';
                                    $requests = (int)($entry['requests'] ?? 0);
                                    $hits = (int)($entry['hits'] ?? 0);
                                    $ratio = $requests > 0 ? ($hits / $requests) * 100 : 0;
                                    $size = (int)($entry['size'] ?? 0);
                                    ?>
                                    <tr>
                                        <td class="trident-col-url"><code><?= $escaper->escapeHtml($path) ?></code></td>
                                        <td class="trident-col-right"><?= $escaper->escapeHtml($viewModel->formatNumber($requests)) ?></td>
                                        <td class="trident-col-right"><?= $escaper->escapeHtml($viewModel->formatNumber($hits)) ?></td>
                                        <td class="trident-col-right"><?= $escaper->escapeHtml($viewModel->formatPercentage($ratio)) ?></td>
                                        <td class="trident-col-right"><?= $escaper->escapeHtml($viewModel->formatBytes($size)) ?></td>
                                    </tr>
                                <?php endforeach; ?>
                            </tbody>
                        </table>
                    </div>
                </div>
            <?php endif; ?>

            <?php $latency = $viewModel->getLatencyStats(); ?>
            <?php $latencyData = is_array($latency) ? ($latency['latency'] ?? $latency) : null; ?>
            <?php if (is_array($latencyData) && !empty($latencyData)): ?>
                <div class="trident-card trident-card-latency" style="grid-column: 1 / -1;">
                    <h3 class="trident-card-title"><?= $escaper->escapeHtml(__('Request Latency')) ?></h3>
                    <p class="trident-card-description">
                        <?= $escaper->escapeHtml(__('Response time percentiles measured at the cache edge.')) ?>
                    </p>
                    <?php
                    $p50 = $latencyData['p50_ms'] ?? null;
                    $p90 = $latencyData['p90_ms'] ?? null;
                    $p99 = $latencyData['p99_ms'] ?? null;
                    $avgMs = $latencyData['avg_ms'] ?? null;
                    $maxMs = $latencyData['max_ms'] ?? null;
                    ?>
                    <div class="trident-stats-row">
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $p50 !== null ? $escaper->escapeHtml(number_format((float)$p50, 2) . ' ms') : '&mdash;' ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('p50')) ?></span>
                        </div>
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $p90 !== null ? $escaper->escapeHtml(number_format((float)$p90, 2) . ' ms') : '&mdash;' ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('p90')) ?></span>
                        </div>
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $p99 !== null ? $escaper->escapeHtml(number_format((float)$p99, 2) . ' ms') : '&mdash;' ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('p99')) ?></span>
                        </div>
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $avgMs !== null ? $escaper->escapeHtml(number_format((float)$avgMs, 2) . ' ms') : '&mdash;' ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Average')) ?></span>
                        </div>
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $maxMs !== null ? $escaper->escapeHtml(number_format((float)$maxMs, 2) . ' ms') : '&mdash;' ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Max')) ?></span>
                        </div>
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml($viewModel->formatNumber((int)($latencyData['count'] ?? 0))) ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Requests')) ?></span>
                        </div>
                    </div>
                </div>
            <?php endif; ?>

            <?php $memory = $viewModel->getMemory(); ?>
            <?php $snapshot = is_array($memory) ? ($memory['snapshot'] ?? null) : null; ?>
            <?php if (is_array($snapshot)): ?>
                <?php
                $allocator = $snapshot['allocator'] ?? [];
                $rssBytes = (int)($allocator['rss_bytes'] ?? 0);
                $trackedLogical = (int)($snapshot['tracked_logical_bytes'] ?? 0);
                $trackedCapacity = (int)($snapshot['tracked_capacity_bytes'] ?? 0);
                $untrackedFraction = (float)($snapshot['untracked_fraction'] ?? 0);
                $categories = $snapshot['categories'] ?? [];
                if (is_array($categories)) {
                    usort($categories, static function (array $a, array $b): int {
                        return (int)($b['logical_bytes'] ?? 0) <=> (int)($a['logical_bytes'] ?? 0);
                    });
                } else {
                    $categories = [];
                }
                ?>
                <div class="trident-card trident-card-memory" style="grid-column: 1 / -1;">
                    <h3 class="trident-card-title"><?= $escaper->escapeHtml(__('Memory')) ?></h3>
                    <div class="trident-stats-row">
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml($viewModel->formatBytes($rssBytes)) ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Resident Set Size')) ?></span>
                        </div>
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml($viewModel->formatBytes($trackedLogical)) ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Tracked Logical')) ?></span>
                        </div>
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml($viewModel->formatBytes($trackedCapacity)) ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Tracked Capacity')) ?></span>
                        </div>
                        <div class="trident-stat">
                            <span class="trident-stat-value"><?= $escaper->escapeHtml($viewModel->formatPercentage($untrackedFraction * 100)) ?></span>
                            <span class="trident-stat-label"><?= $escaper->escapeHtml(__('Untracked')) ?></span>
                        </div>
                    </div>
                    <?php if (!empty($categories)): ?>
                        <div class="trident-table-wrapper">
                            <table class="admin__table-primary trident-table trident-memory-table">
                                <thead>
                                    <tr>
                                        <th><?= $escaper->escapeHtml(__('Category')) ?></th>
                                        <th class="trident-col-right"><?= $escaper->escapeHtml(__('Logical')) ?></th>
                                        <th class="trident-col-right"><?= $escaper->escapeHtml(__('Capacity')) ?></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <?php foreach (array_slice($categories, 0, 10) as $category): ?>
                                        <tr>
                                            <td><?= $escaper->escapeHtml((string)($category['name'] ?? '')) ?></td>
                                            <td class="trident-col-right"><?= $escaper->escapeHtml($viewModel->formatBytes((int)($category['logical_bytes'] ?? 0))) ?></td>
                                            <td class="trident-col-right"><?= $escaper->escapeHtml($viewModel->formatBytes((int)($category['capacity_bytes'] ?? 0))) ?></td>
                                        </tr>
                                    <?php endforeach; ?>
                                </tbody>
                            </table>
                        </div>
                    <?php endif; ?>
                </div>
            <?php endif; ?>

            <?php $protection = $viewModel->getProtectionStats(); ?>
            <?php $backends = is_array($protection) ? ($protection['backends'] ?? null) : null; ?>
            <?php if (is_array($backends) && !empty($backends)): ?>
                <div class="trident-card trident-card-protection" style="grid-column: 1 / -1;">
                    <h3 class="trident-card-title"><?= $escaper->escapeHtml(__('Backend Protection')) ?></h3>
                    <p class="trident-card-description">
                        <?= $escaper->escapeHtml(__('Origin protection state per backend (request collapsing, circuit breaking, throttling).')) ?>
                    </p>
                    <div class="trident-table-wrapper">
                        <table class="admin__table-primary trident-table trident-protection-table">
                            <thead>
                                <tr>
                                    <th><?= $escaper->escapeHtml(__('Backend')) ?></th>
                                    <th class="trident-col-right"><?= $escaper->escapeHtml(__('Details')) ?></th>
                                </tr>
                            </thead>
                            <tbody>
                                <?php foreach ($backends as $backendName => $backendData): ?>
                                    <tr>
                                        <td><code><?= $escaper->escapeHtml((string)$backendName) ?></code></td>
                                        <td class="trident-col-right">
                                            <?php if (is_array($backendData)): ?>
                                                <?php $parts = [];
                                                foreach ($backendData as $key => $val) {
                                                    if (is_scalar($val) || $val === null) {
                                                        $parts[] = (string)$key . ': ' . (is_bool($val) ? ($val ? 'yes' : 'no') : (string)$val);
                                                    }
                                                } ?>
                                                <?= $escaper->escapeHtml(implode(', ', $parts)) ?>
                                            <?php else: ?>
                                                <?= $escaper->escapeHtml((string)$backendData) ?>
                                            <?php endif; ?>
                                        </td>
                                    </tr>
                                <?php endforeach; ?>
                            </tbody>
                        </table>
                    </div>
                </div>
            <?php endif; ?>

            <?php $errorStats = $viewModel->getErrorStats(); ?>
            <?php $errors = is_array($errorStats) ? ($errorStats['errors'] ?? []) : []; ?>
            <?php if (is_array($errors) && !empty($errors)): ?>
                <div class="trident-card trident-card-errors" style="grid-column: 1 / -1;">
                    <h3 class="trident-card-title"><?= $escaper->escapeHtml(__('Recent Errors')) ?></h3>
                    <p class="trident-card-description">
                        <?= $escaper->escapeHtml(__('Total errors recorded: %1', $viewModel->formatNumber((int)($errorStats['total_errors'] ?? 0)))) ?>
                    </p>
                    <div class="trident-table-wrapper">
                        <table class="admin__table-primary trident-table trident-errors-table">
                            <thead>
                                <tr>
                                    <th><?= $escaper->escapeHtml(__('URL')) ?></th>
                                    <th class="trident-col-right"><?= $escaper->escapeHtml(__('Status')) ?></th>
                                    <th class="trident-col-right"><?= $escaper->escapeHtml(__('Count')) ?></th>
                                    <th class="trident-col-right"><?= $escaper->escapeHtml(__('Last Occurred')) ?></th>
                                </tr>
                            </thead>
                            <tbody>
                                <?php foreach ($errors as $error): ?>
                                    <tr>
                                        <td class="trident-col-url"><code><?= $escaper->escapeHtml((string)($error['url'] ?? '')) ?></code></td>
                                        <td class="trident-col-right"><?= $escaper->escapeHtml((string)($error['status_code'] ?? '')) ?></td>
                                        <td class="trident-col-right"><?= $escaper->escapeHtml($viewModel->formatNumber((int)($error['count'] ?? 0))) ?></td>
                                        <td class="trident-col-right"><?= $escaper->escapeHtml((string)($error['last_occurred'] ?? '')) ?></td>
                                    </tr>
                                <?php endforeach; ?>
                            </tbody>
                        </table>
                    </div>
                </div>
            <?php endif; ?>

            <div class="trident-api-info">
                <p><strong><?= $escaper->escapeHtml(__('API Endpoint:')) ?></strong> <?= $escaper->escapeHtml($viewModel->getApiUrl()) ?></p>
            </div>
        <?php endif; ?>
    <?php endif; ?>
</div>
