        <script>
            require(['jquery'], function ($) {
                'use strict';

                var $form = $('#trident-purge-url-form'),
                    $result = $('#trident-purge-url-result');

                $form.on('submit', function (event) {
                    event.preventDefault();

                    var url = $form.find('input[name="url"]').val(),
                        formKey = $form.find('input[name="form_key"]').val();

                    if (!url) {
                        return;
                    }

                    $.ajax({
                        url: $form.data('action'),
                        type: 'POST',
                        contentType: 'application/json',
                        headers: {'X-Requested-With': 'XMLHttpRequest'},
                        data: JSON.stringify({url: url, form_key: formKey}),
                        showLoader: true
                    }).done(function (response) {
                        $result
                            .text(response && response.message ? response.message : '')
                            .css('color', response && response.success ? '#1a7d3c' : '#e02b27')
                            .show();
                    }).fail(function () {
                        $result
                            .text('<?= $escaper->escapeJs(__('Request failed. Please check the logs.')) ?>')
                            .css('color', '#e02b27')
                            .show();
                    });
                });
            });
        </script>
