<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- X02: retry purges Trident has not acknowledged -->
        <job name="qoliber_trident_purge_outbox_drain" instance="Qoliber\TridentCache\Cron\DrainPurgeOutbox" method="execute">
            <schedule>* * * * *</schedule>
        </job>
    </group>
</config>
