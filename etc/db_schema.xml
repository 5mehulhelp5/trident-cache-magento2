<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="qoliber_trident_purge_outbox" resource="default" engine="innodb"
           comment="Trident purges committed but not yet acknowledged by the edge">
        <column xsi:type="bigint" name="entity_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="kind" length="8" nullable="false" comment="tags | all"/>
        <column xsi:type="mediumtext" name="tags" nullable="false" comment="JSON array of tags"/>
        <column xsi:type="int" name="attempts" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="varchar" name="instance" length="64" nullable="true"
                comment="X03: the Trident instance that owes this purge; NULL = written before X03, owed to all"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false"/>
        <column xsi:type="timestamp" name="next_attempt_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false"/>
        <column xsi:type="text" name="last_error" nullable="true"/>
        <column xsi:type="timestamp" name="last_error_at" nullable="true" on_update="false"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="QOLIBER_TRIDENT_PURGE_OUTBOX_NEXT_ATTEMPT_AT" indexType="btree">
            <column name="next_attempt_at"/>
        </index>
    </table>
</schema>
