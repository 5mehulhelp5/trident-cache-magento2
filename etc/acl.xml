<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::system">
                    <resource id="Qoliber_TridentCache::trident" title="Trident Cache" sortOrder="100">
                        <resource id="Qoliber_TridentCache::stats" title="View Cache Statistics" sortOrder="10"/>
                        <resource id="Qoliber_TridentCache::purge" title="Purge Cache" sortOrder="20"/>
                        <resource id="Qoliber_TridentCache::warmer" title="Cache Warmer" sortOrder="30"/>
                        <resource id="Qoliber_TridentCache::launch" title="Launch Mode" sortOrder="35"/>
                        <resource id="Qoliber_TridentCache::reflect" title="Reflect Mode" sortOrder="40"/>
                        <resource id="Qoliber_TridentCache::denoisers" title="Denoisers" sortOrder="45"/>
                        <resource id="Qoliber_TridentCache::bans" title="Bans" sortOrder="50"/>
                        <resource id="Qoliber_TridentCache::backends" title="Backends" sortOrder="55"/>
                        <resource id="Qoliber_TridentCache::dns" title="DNS Discovery" sortOrder="60"/>
                        <resource id="Qoliber_TridentCache::events" title="Live Events" sortOrder="65"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Qoliber_TridentCache::config" title="Trident Cache Configuration" sortOrder="100"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
